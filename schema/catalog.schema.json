{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.invalid/meme-laugh-language-packs/catalog.schema.json",
  "title": "Meme Laugh language catalog",
  "type": "object",
  "required": ["schemaVersion", "catalogVersion", "minGameVersion", "languages", "engines"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "type": "integer", "const": 1 },
    "catalogVersion": { "type": "string", "minLength": 1 },
    "minGameVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/language" }
    },
    "engines": {
      "type": "array",
      "items": { "$ref": "#/definitions/component" }
    }
  },
  "definitions": {
    "language": {
      "type": "object",
      "required": ["code", "name", "status", "builtIn", "components"],
      "additionalProperties": false,
      "properties": {
        "code": { "type": "string", "pattern": "^[a-z]{2}$" },
        "name": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "enum": ["complete", "partial", "missing"] },
        "builtIn": { "type": "boolean" },
        "components": {
          "type": "array",
          "items": { "$ref": "#/definitions/component" }
        }
      }
    },
    "component": {
      "type": "object",
      "required": [
        "id", "kind", "language", "version", "url", "sha256", "sizeBytes",
        "minGameVersion", "license", "licenseUrl", "dependencies", "installSubfolder"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["ui", "dialogue"]
        },
        "language": { "type": "string", "pattern": "^(any|[a-z]{2})$" },
        "version": { "type": "integer", "minimum": 1 },
        "url": { "type": "string" },
        "sha256": { "type": "string" },
        "sizeBytes": { "type": "integer", "minimum": 0 },
        "minGameVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
        "license": { "type": "string", "minLength": 1 },
        "licenseUrl": { "type": "string" },
        "dependencies": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "installSubfolder": { "type": "string", "minLength": 1 },
        "builtIn": { "type": "boolean" },
        "optional": { "type": "boolean" }
      }
    }
  }
}
